# ============================================
# BACKEND ENVIRONMENT VARIABLES (FastAPI)
# ============================================

# AI Service API Keys
# Get from: https://console.groq.com (FREE - Recommended)
GROQ_API_KEY=

# Alternative AI Providers (Optional)
HUGGING_FACE_API_TOKEN=
STABILITY_API_KEY=
OPENAI_API_KEY=
# Image Provider API Keys (Optional - for Design Feed)
# Get from: https://www.pexels.com/api/ (FREE)
PEXELS_API_KEY=your_pexels_api_key_here

# Get from: https://unsplash.com/developers (FREE)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Get from: https://pixabay.com/api/docs/ (FREE)
PIXABAY_API_KEY=your_pixabay_api_key_here

# Geolocation & Places API (Optional)
# Get from: https://www.geoapify.com/ (FREE tier available)
GEOAPIFY_API_KEY=

# Vastu & Astrology Services (Optional)
ASTROLOGY_API_KEY=your_astrology_api_key_here

# MCP Server (Optional - for Tavily integration)
TAVILY_API_KEY=your_tavily_api_key_here
MCP_SERVER_URL=http://localhost:3001

# ============================================
# NOTES
# ============================================
# 1. GROQ_API_KEY is the most important - get this first!
# 2. All image provider keys are optional but recommended
# 3. Free tiers available for most services
# 4. Never commit actual API keys to git
